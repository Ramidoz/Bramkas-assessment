# ===========================================================================
# Codebase Analyzer configuration. Copy to `.env` and edit.
# Every setting has a sensible default; the program is model-agnostic.
# ===========================================================================

# --- LLM provider selection --------------------------------------------------
# provider: anthropic | openai | ollama | google_genai | groq | mistralai | ...
# (anything LangChain's init_chat_model understands)
LLM_PROVIDER=anthropic

# The model used for the per-file "map" pass. Default to a cheap/small model —
# the pipeline is designed to work even with modest, inexpensive models.
LLM_MODEL=claude-haiku-4-5-20251001

# Optional: a (usually stronger) model for the final "reduce"/synthesis pass.
# Leave blank to reuse LLM_MODEL for everything (fully single-model / cheapest).
SYNTHESIS_MODEL=

# Sampling temperature (0 = deterministic, best for structured extraction).
LLM_TEMPERATURE=0

# Max output tokens per LLM response.
LLM_MAX_OUTPUT_TOKENS=2048

# Optional base URL for OpenAI-compatible servers (Ollama, LM Studio, vLLM, ...).
# e.g. http://localhost:11434/v1  (Ollama)   or   http://localhost:1234/v1 (LM Studio)
# Used when LLM_PROVIDER=openai.
# LLM_API_BASE=

# API key — read from the provider's conventional variable if unset here.
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...

# --- Token budgeting ---------------------------------------------------------
# Max INPUT tokens fed to the model in a single request. Keep this comfortably
# below the model's context window so even small-context models work.
MAX_INPUT_TOKENS_PER_REQUEST=6000

# Tokenizer used for counting (tiktoken encoding). cl100k_base is a good
# provider-neutral approximation.
TOKENIZER_ENCODING=cl100k_base

# --- Structured output -------------------------------------------------------
# auto   : try native tool-calling, fall back to parser+auto-repair on failure
# native : force native structured output (tool/function calling)
# parser : force prompt + PydanticOutputParser + OutputFixingParser
# The parser path is what makes cheap/local models that lack tool-calling work.
STRUCTURED_OUTPUT_MODE=auto

# --- Scope / cost controls ---------------------------------------------------
# Limit how many source files are analyzed (0 = no limit). Files are ranked by
# architectural importance (controllers > services > entities > ... ) first.
MAX_FILES=0

# Concurrency for the map pass (parallel LLM calls). Lower for rate-limited keys.
MAX_CONCURRENCY=4
